
# Server
PORT=5000

# Frontend origin allowed by CORS and Better Auth trustedOrigins
CLIENT_URL=http://localhost:3000

# Database
DB_NAME=gearnestDB
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/

# Better Auth
# Local:   http://localhost:5000
# Prod:    https://your-api-domain.tld
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_SECRET=generate-a-long-random-string

# Stripe (test mode keys, optional - payments return 503 without them)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Frontend redirect paths used by Stripe Checkout
PAYMENT_SUCCESS_PATH=/payment/success
PAYMENT_CANCEL_PATH=/payment/cancel

# scripts/recover-admin.js only (never set in the running app)
# CONFIRM_ADMIN_RECOVERY=YES
# RECOVER_ADMIN_EMAIL=
# RECOVER_ADMIN_PASSWORD=

# Optional: enables the admin section of `npm test`
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
